# Copy to .env.local for Vite dev (same folder as package.json)

# Leave empty to use Vite proxy to the API
VITE_API_BASE_URL=

# Unsplash Access Key (public client); used in browser for search + download ping — exposed in built JS
VITE_UNSPLASH_ACCESS_KEY=

# Must match backend INGEST_TOKEN so "Re-index" works when the API requires a token
VITE_INGEST_TOKEN=rag-dev-ingest-xk9m2p7q
