# Copy to .env next to docker-compose.yml (Compose loads it automatically)

OPENAI_API_KEY=

# First auto-ingest in Docker: 0 = skip Linkss.txt URLs (fast). Use all for every URL.
AUTO_INGEST_URL_LIMIT=0

# Protects POST /ingest/ — must match X-Ingest-Token (see README)
INGEST_TOKEN=rag-dev-ingest-xk9m2p7q

# When running the API on the host (not in Docker), point at local Redis:
REDIS_URL=redis://127.0.0.1:6379/0

# Optional: local Postgres if you use docker compose for DB only
# DATABASE_URL=postgresql+psycopg://rag:rag@127.0.0.1:5432/ragchat
