OPENAI_API_KEY=sk-...
# Optional: require this header value for POST /ingest (omit to allow open ingest in dev)
INGEST_TOKEN=

CHROMA_PATH=./chroma_db
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DATA_DIR=../data

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=8
MAX_URL_BYTES=2000000
URL_FETCH_TIMEOUT=60

OPENAI_CHAT_MODEL=gpt-4o-mini

# PostgreSQL (see docker-compose.yml at repo root)
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/ragchat
CHAT_HISTORY_LIMIT=20
SESSION_SUMMARY_MAX_CHARS=2000
CHAT_HISTORY_MAX_CHARS=12000
